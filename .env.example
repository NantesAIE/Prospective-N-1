# Copier en .env (jamais versionné) et renseigner la clé.
# Passerelle Capgemini Generative Engine (réseau ou VPN d'entreprise requis)
AGENT_API_KEY=
AGENT_BASE_URL=https://openai.generative-eu.engine.capgemini.com/v1
AGENT_MODEL=anthropic.claude-opus-5
AGENT_MODEL_FAST=anthropic.claude-sonnet-5

# Mode démo : rejoue une session préenregistrée, sans passerelle ni réseau
DEMO=false

# Serveur local (ne pas exposer au réseau)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Clés des connecteurs P2 (gratuites, optionnelles)
PODCAST_INDEX_KEY=
PODCAST_INDEX_SECRET=
OPENALEX_API_KEY=
PISTE_CLIENT_ID=
PISTE_CLIENT_SECRET=
RADIO_FRANCE_API_KEY=
INPI_USERNAME=
INPI_PASSWORD=
